{
  "name": "presentkim/libmultilingual",
  "description": "Multilingual message support for axolotl-pm/PocketMine-MP plugins",
  "type": "library",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "pocketmine/pocketmine-mp": "^5.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\libmultilingual\\": "src/kim/present/libmultilingual/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\libmultilingual\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
